{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src"]
}
